{
  "name": "iptv-player",
  "private": true,
  "version": "1.0.0",
  "description": "IPTV player for LG webOS TV",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p tsconfig.service.json",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs && node scripts/build-service.mjs",
    "package": "node scripts/ares.mjs package",
    "install:tv": "node scripts/ares.mjs install",
    "launch:tv": "node scripts/ares.mjs launch",
    "inspect:tv": "node scripts/ares.mjs inspect"
  },
  "dependencies": {
    "@juggle/resize-observer": "3.4.0",
    "@noriginmedia/norigin-spatial-navigation": "3.3.0",
    "abortcontroller-polyfill": "1.7.8",
    "core-js": "3.50.0",
    "hls.js": "1.7.3",
    "idb": "8.0.4",
    "mpegts.js": "1.8.2",
    "opus-decoder": "0.7.1",
    "pako": "3.0.2",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@webos-tools/cli": "3.2.6",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "core-js-compat": "3.50.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
